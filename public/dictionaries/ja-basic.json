{
  "version": 1,
  "name": "基本辞書（誤字・表記ゆれ）",
  "description": "日本語の代表的な誤字・表記ゆれを網羅した標準辞書",
  "rules": [
    { "expected": "依頼", "patterns": ["/以来(?=し|する|したい|したく|して|します|でき|され)/g"], "severity": "error", "message": "「依頼」の誤りではありませんか？「以来」は『〜してから』の意味です" },
    { "expected": "ご依頼", "patterns": ["ご以来"], "severity": "error", "message": "「ご依頼」の誤りです。「以来」は『〜してから』の意味です" },
    { "expected": "異動", "patterns": ["/(?<=人事(?:を|が)?)移動(?=で|に|により|となり|となる|になっ|されまし|されました|します|した)/g"], "severity": "warning", "message": "「異動」（人事の移動）の誤りではありませんか？「移動」は物理的な移動を表します" },
    { "expected": "適用", "patterns": ["/(?<=(?:を|が|に))適応(?=する|します|して|され)/g"], "severity": "warning", "message": "「適用」（あてはめる）の誤りではありませんか？「適応」は『環境に順応する』意味です" },
    { "expected": "関心", "patterns": ["/(?<=(?:に|を))感心(?=がある|を寄せ|を抱|を持)/g"], "severity": "warning", "message": "「関心」（興味）の誤りです。「感心」は『心を動かされる』意味です" },
    { "expected": "保証", "patterns": ["/(?<=(?:品質|身元|性能|動作|安全)を)保障/g"], "severity": "warning", "message": "「保証」（責任を持つ）の誤りです。「保障」は『保護する』意味です" },
    { "expected": "鑑賞", "patterns": ["/(?<=(?:映画|音楽|演劇|絵画|美術|演奏)を)観賞/g"], "severity": "warning", "message": "芸術鑑賞は「鑑賞」です。「観賞」は『観て楽しむ』(植物・魚など)" },
    { "expected": "対象", "patterns": ["/(?<=(?:が|を|の))対照(?=者|物|として|に)/g"], "severity": "warning", "message": "「対象」（目標・相手）の誤りではありませんか？「対照」は『比較する』意味です" },
    { "expected": "再開", "patterns": ["/(?<=(?:会議|営業|交渉|議論|サービス|販売)を)再会/g"], "severity": "warning", "message": "「再開」（再び始める）の誤りです。「再会」は『再び会う』意味です" },
    { "expected": "進め", "patterns": ["/(?<=(?:計画|議論|事業|仕事|プロジェクト|会議)を)勧め/g"], "severity": "warning", "message": "「進める」（前進させる）の誤りではありませんか？「勧める」は『推奨する』意味です" },
    { "expected": "始め", "patterns": ["/(?<=(?:年|月|週|期|学期)の)初め/g"], "severity": "info", "message": "「始め」（開始時期）の方が一般的です" },
    { "expected": "初めて", "patterns": ["/始めて(?=の|会|来|聞|見|読|食)/g"], "severity": "warning", "message": "「初めて」（最初の経験）の誤りです" },
    { "expected": "必至", "patterns": ["/(?<=(?:な|敗北|決着|崩壊|失敗|遅延)が?)必死/g"], "severity": "warning", "message": "「必至」（必然）の誤りではありませんか？「必死」は『命がけ』" },
    { "expected": "行う", "patterns": ["行なう"], "severity": "info", "message": "現代の表記は「行う」が一般的です（公用文・新聞表記）" },
    { "expected": "行った", "patterns": ["行なった"], "severity": "info", "message": "現代の表記は「行った」が一般的です" },
    { "expected": "行います", "patterns": ["行ないます"], "severity": "info", "message": "現代の表記は「行います」が一般的です" },
    { "expected": "表す", "patterns": ["表わす"], "severity": "info", "message": "送り仮名は「表す」が現代の標準です" },
    { "expected": "現す", "patterns": ["現わす"], "severity": "info", "message": "送り仮名は「現す」が現代の標準です" },
    { "expected": "著す", "patterns": ["著わす"], "severity": "info", "message": "送り仮名は「著す」が現代の標準です" },
    { "expected": "断る", "patterns": ["断わる"], "severity": "info", "message": "送り仮名は「断る」が現代の標準です" },
    { "expected": "行き先", "patterns": ["行先"], "severity": "info", "message": "送り仮名「行き先」が一般的です" },
    { "expected": "売り上げ", "patterns": ["/売上(?![げ高金])/g"], "severity": "info", "message": "送り仮名「売り上げ」が一般的です（複合名詞では「売上高」も可）" },
    { "expected": "受け付け", "patterns": ["/受付(?![係時間業])/g"], "severity": "info", "message": "送り仮名「受け付け」が一般的です" },
    { "expected": "打ち合わせ", "patterns": ["/打合せ|打合わせ/g"], "severity": "info", "message": "送り仮名「打ち合わせ」が一般的です" },
    { "expected": "引っ越し", "patterns": ["/引越(?!し業)/g"], "severity": "info", "message": "送り仮名「引っ越し」が一般的です" },
    { "expected": "振り込み", "patterns": ["/振込(?!み|手数料|先|金額)/g"], "severity": "info", "message": "送り仮名「振り込み」が一般的です" },
    { "expected": "立ち上げ", "patterns": ["/立上げ/g"], "severity": "info", "message": "送り仮名「立ち上げ」が一般的です" },
    { "expected": "組み合わせ", "patterns": ["/組合せ|組合わせ/g"], "severity": "info", "message": "送り仮名「組み合わせ」が一般的です" },
    { "expected": "話し合い", "patterns": ["/話合い|話合(?!員)/g"], "severity": "info", "message": "送り仮名「話し合い」が一般的です" },
    { "expected": "ください", "patterns": ["下さい"], "severity": "info", "message": "補助動詞の「ください」は通常ひらがなで書きます" },
    { "expected": "いただく", "patterns": ["頂く"], "severity": "info", "message": "補助動詞の「いただく」は通常ひらがなで書きます" },
    { "expected": "できる", "patterns": ["出来る"], "severity": "info", "message": "補助動詞の「できる」は通常ひらがなで書きます" },
    { "expected": "とき", "patterns": ["時に"], "severity": "info", "message": "形式名詞の「とき」はひらがなが推奨されます" },
    { "expected": "ところ", "patterns": ["所が"], "severity": "info", "message": "形式名詞の「ところ」はひらがなが推奨されます" },
    { "expected": "意外", "patterns": ["以外と"], "severity": "warning", "message": "「思いがけない」の意は「意外」です（「以外」は除く意味）" },
    { "expected": "以外", "patterns": ["意外に[^な意]"], "severity": "info", "message": "「除外」の意は「以外」です（「意外」は思いがけない意味）" },
    { "expected": "適用", "patterns": ["摘要を適用"], "severity": "warning", "message": "「適用」と「摘要」は意味が異なります" },
    { "expected": "保証", "patterns": ["保障する品質"], "severity": "warning", "message": "「保証」（責任）と「保障」（保護）の使い分けを確認" },
    { "expected": "話", "patterns": ["話し合いを話"], "severity": "info", "message": "送り仮名の確認" },
    { "expected": "申し込む", "patterns": ["申込む"], "severity": "info", "message": "送り仮名「申し込む」が一般的です" },
    { "expected": "取り扱い", "patterns": ["取扱い"], "severity": "info", "message": "送り仮名「取り扱い」が一般的です" },
    { "expected": "問い合わせ", "patterns": ["問合せ", "問合わせ"], "severity": "info", "message": "送り仮名「問い合わせ」が一般的です" },
    { "expected": "ひと言", "patterns": ["一言で言うと"], "severity": "info", "message": "「ひと言」「一言」の表記を統一しましょう" },
    { "expected": "サーバー", "patterns": ["サーバ"], "severity": "info", "message": "JIS Z 8301 では長音符を付ける表記が推奨されます" },
    { "expected": "ユーザー", "patterns": ["ユーザ(?![ーズ])"], "severity": "info", "message": "JIS Z 8301 では長音符を付ける表記が推奨されます" },
    { "expected": "コンピューター", "patterns": ["コンピュータ(?![ー])"], "severity": "info", "message": "JIS Z 8301 では長音符を付ける表記が推奨されます" },
    { "expected": "プリンター", "patterns": ["プリンタ(?![ー])"], "severity": "info", "message": "JIS Z 8301 では長音符を付ける表記が推奨されます" },
    { "expected": "メモリー", "patterns": ["メモリ(?![ー])"], "severity": "info", "message": "JIS Z 8301 では長音符を付ける表記が推奨されます" },
    { "expected": "なお", "patterns": ["尚"], "severity": "info", "message": "接続詞は通常ひらがなで書きます" },
    { "expected": "また", "patterns": ["又"], "severity": "info", "message": "接続詞は通常ひらがなで書きます" },
    { "expected": "ただし", "patterns": ["但し"], "severity": "info", "message": "接続詞は通常ひらがなで書きます" },
    { "expected": "もちろん", "patterns": ["勿論"], "severity": "info", "message": "接続詞は通常ひらがなで書きます" },
    { "expected": "あらかじめ", "patterns": ["予め"], "severity": "info", "message": "副詞は通常ひらがなで書きます" },
    { "expected": "すぐに", "patterns": ["直ぐに"], "severity": "info", "message": "副詞は通常ひらがなで書きます" }
  ]
}
